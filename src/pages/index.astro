<!--
  THESIS: El catálogo es la página. Sin hero que robe atención. El visitante ve
  inmediatamente las tarjetas de animaciones ordenadas en grid, con thumbnails
  y metadata, y entiende de qué va el proyecto por la estructura misma del catálogo.

  OWN-WORLD: Fondo oscuro espacial (#05070a) con acento azul NASA (#4facfe).
  Tipografía sistema limpia. Starfield Three.js como textura ambiental de fondo.

  STORY: El visitante llega, ve un grid de tarjetas con thumbnails estilo YouTube,
  filtra por categoría, hace clic en una animación y entra a la experiencia 3D.

  FIRST VIEWPORT: Top bar compacta (logo + search). Grid de tarjetas con thumbnail
  16:9, título, categoría y tags. Filtros como píldoras.
  Starfield animado de fondo sutil.

  FORM: YouTube-grid sobre lienzo NASA. Catálogo clásico con thumbnails.

  FINISH: unreviewed and undocumented is unfinished; this build ends with the
  finish review, the verdict, and DESIGN.md.
-->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Astro Animations</title>
  <meta name="description" content="Simulaciones 3D educativas de fenómenos astrofísicos. Supernovas, agujeros negros, púlsares y más." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script type="importmap">
    {
      "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js"
      }
    }
  </script>
  <style is:global>
    :root {
      --bg: #020408;
      --bg-raised: #0d1520;
      --border: rgba(80, 150, 255, 0.12);
      --text: #e6f0ff;
      --text-secondary: #8aa4c8;
      --accent: #4facfe;
      --accent-red: #e84d3d;
      --font: 'Segoe UI', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    a, a:link, a:visited { color: inherit; text-decoration: none; }
    html { scroll-behavior: smooth; }
    html, body {
      width: 100%;
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: var(--font);
      -webkit-font-smoothing: antialiased;
    }

    #starfield-canvas {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
      opacity: 0.7;
    }

    .app {
      position: relative;
      z-index: 1;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ===== TOP BAR ===== */
    .top-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 0.75rem 1.5rem;
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(12px);
      background: rgba(5, 7, 10, 0.7);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    .logo {
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--text);
      text-decoration: none;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }
    .logo span { color: var(--accent); }

    .search-container {
      flex: 1;
      max-width: 480px;
      position: relative;
      margin: 0 auto;
    }
    .search-container input {
      width: 100%;
      padding: 0.5rem 1rem 0.5rem 2.5rem;
      background: rgba(255,255,255,0.06);
      border: 1px solid var(--border);
      border-radius: 8px;
      color: var(--text);
      font-size: 0.875rem;
      outline: none;
      transition: border-color 0.2s;
    }
    .search-container input:focus { border-color: var(--accent); }
    .search-container input::placeholder { color: var(--text-secondary); }
    .search-icon {
      position: absolute;
      left: 0.75rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-secondary);
      font-size: 0.9rem;
      pointer-events: none;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .nav-link {
      color: var(--text-secondary);
      text-decoration: none;
      font-size: 0.85rem;
      transition: color 0.2s;
    }
    .nav-link:hover { color: var(--text); }

    /* ===== MAIN ===== */
    .main-content {
      flex: 1;
      max-width: 1400px;
      width: 100%;
      margin: 0 auto;
      padding: 1.5rem;
    }

    .section-heading {
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 0.5rem;
      letter-spacing: 0.01em;
    }
    .section-desc {
      color: var(--text-secondary);
      font-size: 0.9rem;
      line-height: 1.5;
      margin-bottom: 1.25rem;
    }

    /* ===== FILTERS ===== */
    .filters {
      display: flex;
      gap: 0.5rem;
      padding: 0 0 1.25rem;
      flex-wrap: wrap;
      border-bottom: 1px solid var(--border);
      margin-bottom: 1.5rem;
    }

    .filter-btn {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.4rem 0.85rem;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text-secondary);
      font-size: 0.8rem;
      font-family: var(--font);
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover {
      border-color: rgba(79, 172, 254, 0.3);
      color: var(--text);
    }
    .filter-btn.active {
      background: rgba(79, 172, 254, 0.12);
      border-color: var(--accent);
      color: var(--text);
    }
    .filter-icon { font-size: 0.85rem; }

    /* ===== GRID ===== */
    .animation-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 1.25rem;
    }

    .animation-card {
      display: flex;
      flex-direction: column;
      background: var(--bg-raised);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      color: inherit;
      transition: all 0.25s ease;
    }
    .animation-card:hover {
      border-color: rgba(79, 172, 254, 0.3);
      transform: translateY(-2px);
    }

    .card-thumb-wrap {
      position: relative;
      width: 100%;
      aspect-ratio: 16 / 9;
      overflow: hidden;
      background: linear-gradient(135deg, #0a1628 0%, #1a2a4a 100%);
    }
    .card-thumb-placeholder {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
      opacity: 0.25;
    }

    .card-body {
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      flex: 1;
    }
    .card-title {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .card-meta {
      font-size: 0.78rem;
      color: var(--text-secondary);
    }
    .card-tags {
      display: flex;
      gap: 0.35rem;
      flex-wrap: wrap;
      margin-top: auto;
      padding-top: 0.5rem;
    }
    .card-tag {
      padding: 0.15rem 0.5rem;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 4px;
      font-size: 0.7rem;
      color: var(--text-secondary);
    }

    /* ===== FOOTER ===== */
    .footer {
      text-align: center;
      padding: 2rem 1.5rem;
      border-top: 1px solid var(--border);
      font-size: 0.8rem;
      color: var(--text-secondary);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 900px) {
      .animation-grid { grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    }
    @media (max-width: 600px) {
      .top-bar { padding: 0.5rem 0.75rem; gap: 0.5rem; }
      .search-container { max-width: 180px; }
      .main-content { padding: 1rem; }
      .animation-grid { grid-template-columns: 1fr; gap: 0.85rem; }
    }
  </style>
</head>
<body>
  <canvas id="starfield-canvas"></canvas>

  <div class="app">
    <header class="top-bar">
      <a href="/astro-animations/" class="logo">astro<span>animations</span></a>
      <div class="search-container">
        <span class="search-icon">⌕</span>
        <input type="search" placeholder="Buscar animaciones..." aria-label="Buscar animaciones" />
      </div>
      <div class="top-actions">
        <a href="https://github.com/CesarFRR/astro-animations" class="nav-link" target="_blank" rel="noopener">GitHub</a>
      </div>
    </header>

    <main class="main-content">
      <h2 class="section-heading">Catálogo de animaciones</h2>
      <p class="section-desc">Simulaciones 3D interactivas de fenómenos astrofísicos. Explora, orbita y aprende.</p>

      <div class="filters" id="filters">
        <button class="filter-btn active" data-category="todas">🌌 Todas</button>
        <button class="filter-btn" data-category="supernova">💥 Supernovas</button>
        <button class="filter-btn" data-category="estrella">⭐ Estrellas</button>
        <button class="filter-btn" data-category="agujero-negro">🕳️ Agujeros Negros</button>
        <button class="filter-btn" data-category="pulsar">💫 Púlsares</button>
      </div>

      <div class="animation-grid" id="grid"></div>
    </main>

    <footer class="footer">
      <p>Astro Animations · Datos astronómicos reales · MIT License</p>
    </footer>
  </div>

  <script type="module" is:inline>
    import * as THREE from "three";

    // ---- Starfield (pulsar-style) ----
    const canvas = document.getElementById("starfield-canvas");
    const ren = new THREE.WebGLRenderer({ canvas, alpha: true });
    ren.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    function resize() { ren.setSize(window.innerWidth, window.innerHeight); }
    resize();
    window.addEventListener("resize", resize);

    const scene = new THREE.Scene();
    const cam = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 2000);
    cam.position.set(0, 0, 1);

    const N = 5000;
    const geo = new THREE.BufferGeometry();
    const pos = new Float32Array(N * 3);
    const col = new Float32Array(N * 3);
    const siz = new Float32Array(N);
    const starData = [];
    for (let i = 0; i < N; i++) {
      const r = 60 + Math.random() * 500;
      const theta = Math.random() * Math.PI * 2;
      const phi = Math.acos(2 * Math.random() - 1);
      pos[i*3] = r * Math.sin(phi) * Math.cos(theta);
      pos[i*3+1] = r * Math.sin(phi) * Math.sin(theta);
      pos[i*3+2] = r * Math.cos(phi);
      const t = Math.random();
      if (t < 0.45) {
        col[i*3] = 0.9 + Math.random() * 0.1; col[i*3+1] = 0.95 + Math.random() * 0.05; col[i*3+2] = 1.0;
      } else if (t < 0.75) {
        col[i*3] = 1; col[i*3+1] = 1; col[i*3+2] = 1;
      } else if (t < 0.9) {
        col[i*3] = 1; col[i*3+1] = 0.85; col[i*3+2] = 0.6;
      } else {
        col[i*3] = 1; col[i*3+1] = 0.65; col[i*3+2] = 0.45;
      }
      siz[i] = 0.1 + Math.random() * 0.4;
      starData.push({ baseSize: siz[i], phase: Math.random() * Math.PI * 2, speed: 0.3 + Math.random() * 1.5 });
    }
    geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
    geo.setAttribute("color", new THREE.BufferAttribute(col, 3));
    geo.setAttribute("size", new THREE.BufferAttribute(siz, 1));

    const mat = new THREE.PointsMaterial({
      size: 0.6, vertexColors: true, transparent: true, opacity: 0.85, sizeAttenuation: true,
    });
    const stars = new THREE.Points(geo, mat);
    scene.add(stars);

    let starTime = 0;
    (function loop() {
      requestAnimationFrame(loop);
      stars.rotation.y += 0.00005;
      starTime += 0.016;
      const sizes = stars.geometry.attributes.size.array;
      for (let i = 0; i < starData.length; i++) {
        const d = starData[i];
        sizes[i] = d.baseSize * (0.6 + 0.4 * Math.sin(starTime * d.speed + d.phase));
      }
      stars.geometry.attributes.size.needsUpdate = true;
      ren.render(scene, cam);
    })();

    // ---- Data ----
    const animations = [
      { id:"supernova-pares", title:"Supernova de Inestabilidad de Pares", cat:"supernova", diff:"avanzado", tags:["Núcleo masivo","Pares e⁻e⁺","Destrucción total"], icon:"💥" },
      { id:"agujero-negro", title:"Supernova que deja un Agujero Negro", cat:"agujero-negro", diff:"avanzado", tags:["Colapso gravitatorio","Jets relativistas","Disco de acreción"], icon:"🕳️" },
      { id:"enana-blanca", title:"De Gigante Roja a Enana Blanca", cat:"estrella", diff:"basico", tags:["Estrella tipo solar","Nebulosa planetaria","Secuencia principal"], icon:"⭐" },
      { id:"crab-pulsar", title:"Púlsar del Cangrejo (PSR B0531+21)", cat:"pulsar", diff:"intermedio", tags:["Estrella de neutrones","Resto de supernova","Audio 3D"], icon:"💫" },
      { id:"pulsar-vela", title:"Púlsar de Vela (PSR B0833-45)", cat:"pulsar", diff:"intermedio", tags:["Estrella de neutrones","Rotación extrema","Audio 3D"], icon:"💫" },
    ];

    // ---- Render grid ----
    const grid = document.getElementById("grid");
    function renderGrid(cat) {
      grid.innerHTML = "";
      const items = cat === "todas" ? animations : animations.filter(a => a.cat === cat);
      for (const a of items) {
        const card = document.createElement("a");
        card.href = `/astro-animations/animaciones/${a.id}/`;
        card.className = "animation-card";
        card.innerHTML = `
          <div class="card-thumb-wrap">
            <div class="card-thumb-placeholder">${a.icon}</div>
            
          </div>
          <div class="card-body">
            <h3 class="card-title">${a.title}</h3>
            <span class="card-meta">${a.diff} · ${a.cat}</span>
            <div class="card-tags">${a.tags.map(t => `<span class="card-tag">${t}</span>`).join("")}</div>
          </div>`;
        grid.appendChild(card);
      }
    }
    renderGrid("todas");

    // ---- Filter logic ----
    document.querySelectorAll(".filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".filter-btn").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        renderGrid(btn.getAttribute("data-category"));
      });
    });
  </script>
</body>
</html>