---
import AnimationLayout from '../../layouts/AnimationLayout.astro';
---
<AnimationLayout
  title="Supernova que deja un Agujero Negro"
  subtitle="Masa: >25–40 M☉ · Colapso de núcleo · Remanente: agujero negro con disco de acreción"
  scriptSrc="js/bh/main-bh.js"
  navHref="/astro-animations/"
  navLabel="← Catálogo"
  phaseTitle="Supergigante roja"
  phaseCaption="Una estrella de más de ~25 masas solares vive rápido y muere joven."
>
  <div slot="phase-actions">
    <button id="mobile-curve-toggle" class="mobile-only-btn" title="Mostrar/ocultar curva de luz">📈 Curva</button>
  </div>

  <section class="hud" slot="hud">
    <div class="gauge">
      <span class="gauge-label">T núcleo (GK)</span>
      <div class="gauge-bar"><div id="t-bar" class="gauge-fill" style="width: 10%"></div></div>
      <span id="t-value" class="gauge-value">0.04 GK</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Masa núcleo (M☉)</span>
      <div class="gauge-bar"><div id="m-bar" class="gauge-fill" style="width: 20%"></div></div>
      <span id="m-value" class="gauge-value">0.20 M☉</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Flujo de neutrinos</span>
      <div class="gauge-bar"><div id="n-bar" class="gauge-fill" style="width: 0%"></div></div>
      <span id="n-value" class="gauge-value">0%</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Radio núcleo (km)</span>
      <div class="gauge-bar"><div id="r-bar" class="gauge-fill" style="width: 90%"></div></div>
      <span id="r-value" class="gauge-value">2,600 km</span>
    </div>
  </section>

  <section class="lightcurve-panel" slot="chart">
    <div class="panel-header">
      <h3>Curva de luz</h3>
      <button id="toggle-comparison" class="toggle-btn active" title="Mostrar/ocultar curvas de comparación">Comparar SN II-P / fallida</button>
    </div>
    <svg id="lightcurve-svg" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
  </section>

  <section class="legend" slot="legend">
    <div class="legend-item"><span class="dot neutrino"></span>Neutrinos ν</div>
    <div class="legend-item"><span class="dot ejecta"></span>Eyección</div>
    <div class="legend-item"><span class="dot accretion"></span>Materia al disco</div>
    <div class="legend-item"><span class="dot jet"></span>Jets ~0.99c</div>
  </section>

  <button id="btn-restart" class="ctrl-btn" slot="controls">↺ Reiniciar</button>
  <div class="timeline-wrap" slot="timeline">
    <input id="timeline" type="range" min="0" max="1000" value="0" step="1">
    <div class="phase-labels">
      <span>Supergigante</span>
      <span>Cebolla</span>
      <span>Colapso</span>
      <span>Explosión</span>
      <span>Agujero negro</span>
      <span>Disco</span>
    </div>
  </div>
</AnimationLayout>
