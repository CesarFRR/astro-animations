---
import AnimationLayout from '../../layouts/AnimationLayout.astro';
---
<AnimationLayout
  title="Supernova de Inestabilidad de Pares"
  subtitle="Masa: 130–250 M☉ · Metalicidad baja · Destrucción total sin remanente"
  scriptSrc="js/main.js"
>
  <header class="top-bar">
    <h1>Supernova de Inestabilidad de Pares</h1>
    <div class="subtitle">Masa: 130–250 M☉ · Metalicidad baja · Destrucción total sin remanente</div>
    <a class="nav-link" href="/astro-animations/animaciones/enana-blanca/">De gigante roja a enana blanca →</a>
  </header>

  <section class="phase-panel">
    <div class="phase-header">
      <h2 id="phase-title">Equilibrio</h2>
      <button id="mobile-curve-toggle" class="mobile-only-btn" title="Mostrar/ocultar curva de luz">📈 Curva</button>
    </div>
    <p id="phase-caption">La estrella sostiene sus capas gracias a la presión de radiación de los rayos gamma del núcleo.</p>
  </section>

  <section class="hud">
    <div class="gauge">
      <span class="gauge-label">T núcleo (×10⁸ K)</span>
      <div class="gauge-bar"><div id="temp-bar" class="gauge-fill" style="width: 10%"></div></div>
      <span id="temp-value" class="gauge-value">0.3</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Presión de radiación</span>
      <div class="gauge-bar"><div id="pressure-bar" class="gauge-fill" style="width: 100%"></div></div>
      <span id="pressure-value" class="gauge-value">100%</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Densidad de pares e⁻e⁺</span>
      <div class="gauge-bar"><div id="pairs-bar" class="gauge-fill" style="width: 0%"></div></div>
      <span id="pairs-value" class="gauge-value">0%</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Luminosidad (×10³⁷ W)</span>
      <div class="gauge-bar"><div id="lum-bar" class="gauge-fill" style="width: 5%"></div></div>
      <span id="lum-value" class="gauge-value">0.05</span>
    </div>
  </section>

  <section class="lightcurve-panel">
    <div class="panel-header">
      <h3>Curva de luz</h3>
      <button id="toggle-comparison" class="toggle-btn active" title="Mostrar/ocultar curvas de supernovas normales">Comparar SN Ia / SN II</button>
    </div>
    <svg id="lightcurve-svg" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
  </section>

  <section class="legend">
    <div class="legend-item"><span class="dot gamma"></span>Rayos γ</div>
    <div class="legend-item"><span class="dot electron"></span>Electrón e⁻</div>
    <div class="legend-item"><span class="dot positron"></span>Positrón e⁺</div>
    <div class="legend-item"><span class="dot nickel"></span>⁵⁶Ni</div>
  </section>

  <section class="controls">
    <button id="btn-play" class="ctrl-btn">⏸ Pausar</button>
    <button id="btn-restart" class="ctrl-btn">↺ Reiniciar</button>
    <div class="speed-control">
      <label for="speed">Velocidad</label>
      <select id="speed">
        <option value="0.25">0.25×</option>
        <option value="0.5">0.5×</option>
        <option value="1" selected>1×</option>
        <option value="2">2×</option>
        <option value="2.5">2.5×</option>
        <option value="3">3×</option>
        <option value="4">4×</option>
        <option value="5">5×</option>
      </select>
    </div>
    <div class="timeline-wrap">
      <input id="timeline" type="range" min="0" max="1000" value="0" step="1">
      <div class="phase-labels">
        <span>Equilibrio</span>
        <span>Pares</span>
        <span>Colapso</span>
        <span>Fusión</span>
        <span>Explosión</span>
        <span>Remanente</span>
      </div>
    </div>
  </section>
</AnimationLayout>
