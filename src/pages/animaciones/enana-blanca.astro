---
import AnimationLayout from '../../layouts/AnimationLayout.astro';
---
<AnimationLayout
  title="De Gigante Roja a Enana Blanca"
  subtitle="Estrella de ~1 M☉ · Muerte tranquila · El núcleo sobrevive como enana blanca"
  scriptSrc="js/wb/main-wb.js"
  navHref="/astro-animations/"
  navLabel="← Catálogo"
  phaseTitle="Secuencia principal"
  phaseCaption="Una estrella como el Sol pasa miles de millones de años fusionando hidrógeno en helio."
>
  <div slot="phase-actions">
    <button id="mobile-curve-toggle" class="mobile-only-btn" title="Mostrar/ocultar curva de luz">📈 Curva</button>
  </div>

  <section class="hud" slot="hud">
    <div class="gauge">
      <span class="gauge-label">T superficie</span>
      <div class="gauge-bar"><div id="t-bar" class="gauge-fill" style="width: 30%"></div></div>
      <span id="t-value" class="gauge-value">5,800 K</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Luminosidad</span>
      <div class="gauge-bar"><div id="l-bar" class="gauge-fill" style="width: 40%"></div></div>
      <span id="l-value" class="gauge-value">1.0 L☉</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Radio</span>
      <div class="gauge-bar"><div id="r-bar" class="gauge-fill" style="width: 45%"></div></div>
      <span id="r-value" class="gauge-value">1.0 R☉</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Edad</span>
      <div class="gauge-bar"><div id="a-bar" class="gauge-fill" style="width: 0%"></div></div>
      <span id="a-value" class="gauge-value">0.01 Gyr</span>
    </div>
  </section>

  <section class="lightcurve-panel" slot="chart">
    <div class="panel-header">
      <h3>Luminosidad vs edad</h3>
      <button id="toggle-comparison" class="toggle-btn active" title="Mostrar/ocultar curva de enfriamiento de la enana blanca">Enfriamiento WD</button>
    </div>
    <svg id="lightcurve-svg" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid meet"></svg>
  </section>

  <section class="legend" slot="legend">
    <div class="legend-item"><span class="dot wind"></span>Viento estelar</div>
    <div class="legend-item"><span class="dot halpha"></span>Hidrógeno (Hα)</div>
    <div class="legend-item"><span class="dot oiii"></span>Oxígeno [O III]</div>
    <div class="legend-item"><span class="dot uv"></span>Fotones UV</div>
  </section>

  <button id="btn-restart" class="ctrl-btn" slot="controls">↺ Reiniciar</button>
  <div class="timeline-wrap" slot="timeline">
    <input id="timeline" type="range" min="0" max="1000" value="0" step="1">
    <div class="phase-labels">
      <span>Sec. principal</span>
      <span>Gig. roja</span>
      <span>Helio</span>
      <span>AGB</span>
      <span>Nebulosa</span>
      <span>E. blanca</span>
    </div>
  </div>
</AnimationLayout>
