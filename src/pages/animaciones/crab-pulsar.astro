---
import AnimationLayout from '../../layouts/AnimationLayout.astro';
---
<AnimationLayout
  title="Púlsar del Cangrejo (PSR B0531+21)"
  subtitle="Estrella de neutrones · Rotación: 33.112 ms · Distancia: 6,500 años luz"
  scriptSrc="js/pulsar/crab.js"
  phaseTitle="Rotación estable"
  phaseCaption="El núcleo colapsado de la supernova SN 1054, una estrella de neutrones girando 30 veces por segundo en el corazón de la Nebulosa del Cangrejo."
>
  <section class="hud" slot="hud">
    <div class="gauge">
      <span class="gauge-label">Frecuencia de rotación</span>
      <div class="gauge-bar"><div id="freq-bar" class="gauge-fill" style="width: 30%"></div></div>
      <span id="freq-value" class="gauge-value">30.2 Hz</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Campo magnético</span>
      <div class="gauge-bar"><div id="mag-bar" class="gauge-fill" style="width: 72%"></div></div>
      <span id="mag-value" class="gauge-value">3.8×10¹² G</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Temperatura superficial</span>
      <div class="gauge-bar"><div id="temp-bar" class="gauge-fill" style="width: 70%"></div></div>
      <span id="temp-value" class="gauge-value">~1.5×10⁶ K</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Edad (desde SN 1054)</span>
      <div class="gauge-bar"><div id="age-bar" class="gauge-fill" style="width: 9%"></div></div>
      <span id="age-value" class="gauge-value">~970 años</span>
    </div>
  </section>

  <button id="btn-mute" class="ctrl-btn" slot="controls">🔊 Sonido</button>
</AnimationLayout>
