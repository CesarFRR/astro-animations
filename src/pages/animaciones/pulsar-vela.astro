---
import AnimationLayout from '../../layouts/AnimationLayout.astro';
---
<AnimationLayout
  title="Púlsar de Vela (PSR B0833-45)"
  subtitle="Estrella de neutrones · Rotación: 11.195 ms · Distancia: 936 años luz"
  scriptSrc="js/pulsar/vela.js"
  phaseTitle="Rotación estable"
  phaseCaption="Una estrella de neutrones de ~1.4 masas solares comprimida en una esfera de 20 km, girando 89 veces por segundo."
>
  <section class="hud" slot="hud">
    <div class="gauge">
      <span class="gauge-label">Frecuencia de rotación</span>
      <div class="gauge-bar"><div id="freq-bar" class="gauge-fill" style="width: 89%"></div></div>
      <span id="freq-value" class="gauge-value">89.33 Hz</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Campo magnético</span>
      <div class="gauge-bar"><div id="mag-bar" class="gauge-fill" style="width: 75%"></div></div>
      <span id="mag-value" class="gauge-value">3.38×10¹² G</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Temperatura superficial</span>
      <div class="gauge-bar"><div id="temp-bar" class="gauge-fill" style="width: 65%"></div></div>
      <span id="temp-value" class="gauge-value">~8×10⁵ K</span>
    </div>
    <div class="gauge">
      <span class="gauge-label">Edad (medida en Vela)</span>
      <div class="gauge-bar"><div id="age-bar" class="gauge-fill" style="width: 11%"></div></div>
      <span id="age-value" class="gauge-value">~11,000 años</span>
    </div>
  </section>

  <button id="btn-mute" class="ctrl-btn" slot="controls">🔊 Sonido</button>
</AnimationLayout>
