---
import Layout from '../../layouts/Layout.astro';
import Canvas3D from '../../components/Canvas3D.astro';
import { animations } from '../../data/animations';

export function getStaticPaths() {
  return animations.map(animation => ({
    params: { id: animation.id },
  }));
}

const { id } = Astro.params;
const animation = animations.find(a => a.id === id);

if (!animation) {
  return Astro.redirect('/astro-animations/');
}
---

<Layout title={animation.title} description={animation.description}>
  <Canvas3D animationId={animation.id} />
  
  <header class="top-bar">
    <h1>{animation.title}</h1>
    <div class="subtitle">{animation.tags.join(' · ')}</div>
    <a class="nav-link" href="/astro-animations/">← Volver al catálogo</a>
  </header>
  
  <section class="phase-panel">
    <div class="phase-header">
      <h2 id="phase-title">Cargando...</h2>
    </div>
    <p id="phase-caption">Espera mientras se inicializa la animación.</p>
  </section>
  
  <section class="hud" id="hud-panel">
    <!-- HUD gauges will be populated by animation script -->
  </section>
  
  <section class="controls">
    <button id="btn-play" class="ctrl-btn">⏸ Pausar</button>
    <button id="btn-restart" class="ctrl-btn">↺ Reiniciar</button>
    <div class="speed-control">
      <label for="speed">Velocidad</label>
      <select id="speed">
        <option value="0.25">0.25×</option>
        <option value="0.5">0.5×</option>
        <option value="1" selected>1×</option>
        <option value="2">2×</option>
        <option value="3">3×</option>
        <option value="5">5×</option>
      </select>
    </div>
    <div class="timeline-wrap">
      <input id="timeline" type="range" min="0" max="1000" value="0" step="1">
    </div>
  </section>
  
  <script define:vars={{ animationId: animation.id }}>
    // Animation controller
    class AnimationController {
      constructor(id) {
        this.id = id;
        this.isPlaying = true;
        this.speed = 1;
        this.timeline = 0;
        this.maxTimeline = 1000;
        
        this.initControls();
      }
      
      initControls() {
        const playBtn = document.getElementById('btn-play');
        const restartBtn = document.getElementById('btn-restart');
        const speedSelect = document.getElementById('speed');
        const timelineSlider = document.getElementById('timeline');
        
        playBtn?.addEventListener('click', () => this.togglePlay());
        restartBtn?.addEventListener('click', () => this.restart());
        speedSelect?.addEventListener('change', (e) => {
          this.speed = parseFloat(e.target.value);
        });
        timelineSlider?.addEventListener('input', (e) => {
          this.timeline = parseInt(e.target.value);
        });
      }
      
      togglePlay() {
        this.isPlaying = !this.isPlaying;
        const playBtn = document.getElementById('btn-play');
        if (playBtn) {
          playBtn.textContent = this.isPlaying ? '⏸ Pausar' : '▶ Reproducir';
        }
      }
      
      restart() {
        this.timeline = 0;
        this.isPlaying = true;
        const timelineSlider = document.getElementById('timeline');
        if (timelineSlider) {
          timelineSlider.value = '0';
        }
      }
      
      update(deltaTime) {
        if (!this.isPlaying) return;
        
        this.timeline += deltaTime * this.speed * 100;
        if (this.timeline >= this.maxTimeline) {
          this.timeline = this.maxTimeline;
          this.isPlaying = false;
        }
        
        const timelineSlider = document.getElementById('timeline');
        if (timelineSlider) {
          timelineSlider.value = this.timeline.toString();
        }
      }
      
      getProgress() {
        return this.timeline / this.maxTimeline;
      }
    }
    
    // Initialize controller
    window.animationController = new AnimationController(animationId);
  </script>
</Layout>

<style>
  .hud {
    display: none;
  }
  
  .hud.active {
    display: block;
  }
</style>
